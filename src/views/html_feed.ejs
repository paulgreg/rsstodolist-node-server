<!DOCTYPE html>
<html lang="<%= locale %>">
    <head>
        <meta charset="utf-8" />
        <title><%= t('common.site_title') %> - <% if (context === 'search') { %><%= t(totalCount > 1 ? 'html_feed.search_title_plural' : 'html_feed.search_title', { count: entries.length, total: totalCount, query: searchQuery }) %><% } else { %><%= t('html_feed.feed_title', { count: entries.length, total: totalCount, name: feedName }) %><% } %></title>
        <meta name="robots" content="noindex, nofollow" />
        <link rel="stylesheet" href="./static/style.css" />
        <link rel="icon" type="image/png" href="./static/favicon.png" />
        <link
            rel="alternate"
            type="application/rss+xml"
            href="<%= rootUrl %><%= url %>&format=rss"
            title="<%= title %>"
        />
        <meta name="viewport" content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0" />
    </head>
    <body>
        <main>
            <%- include('partials/header', {
                description: title
            }) %>
            <p class="feed-title">
                <% if (context === 'search') { %>
                <span><%= t(totalCount > 1 ? 'html_feed.search_title_plural' : 'html_feed.search_title', { count: entries.length, total: totalCount, query: searchQuery }) %></span>
                <% } else { %>
                <span><%= t('html_feed.feed_title', { count: entries.length, total: totalCount, name: feedName }) %></span>
                <% } %>
            </p>
            <div class="header-actions">
                    <a class="button" href="<%= rootUrl %><%= url %>&amp;format=rss<% if (limit) { %>&amp;limit=<%= limit %><% } %><% if (page) { %>&amp;page=<%= page %><% } %>"><%= t('html_feed.actions.open_rss') %></a>
                    <a class="button button--ghost" href="<%= rootUrl %>"><%= t('common.back_to_home') %></a>
                    <a class="button button--ghost" href="<%= rootUrl %><%= url %>&amp;limit=50"><%= t('html_feed.actions.show_entries.50') %></a>
                    <a class="button button--ghost" href="<%= rootUrl %><%= url %>&amp;limit=100"><%= t('html_feed.actions.show_entries.100') %></a>
                    <a class="button button--ghost" href="<%= rootUrl %><%= url %>&amp;limit=250"><%= t('html_feed.actions.show_entries.250') %></a>
                </div>
            </header>

            <% if (public && entries.length > 0) { %>
            <section class="feed-message feed-message--notice">
                <p>
                    <%= t('html_feed.self_host_notice') %> (<a
                        href="https://github.com/paulgreg/rsstodolist-node-server"
                        target="_blank"
                        rel="noopener noreferrer"
                        ><%= t('common.instructions') %></a
                    >).
                </p>
            </section>
            <% } %> <% if (entries.length === 0) { %>
            <section class="feed-message feed-message--empty">
                <h2><%= t('html_feed.empty_state.title') %></h2>
                <p><%= t('html_feed.empty_state.description') %> <a href="<%= rootUrl %>"><%= t('common.back_to_home') %></a>.</p>
            </section>
            <% } else { %>

            <% const safeLimit = limit || entries.length || 1; %>
            <% const safePage = page || 1; %>
            <% const safeTotal = totalCount ?? entries.length; %>
            <% const totalPages = Math.max(1, Math.ceil(safeTotal / safeLimit)); %>
            <% const hasPagination = totalPages > 1; %>
            <section class="feed-entries" aria-label="Feed entries">
                <% entries.forEach((entry, index) => { const timestamp = entry.updatedAt || entry.createdAt; %>
                <article class="feed-entry">
                    <header class="feed-entry__header">
                        <div class="feed-entry__meta">
                            <span class="feed-entry__index">#<%= (offset || 0) + index + 1 %></span>
                            <% if (context === "search") { %>
                            <a href="<%= rootUrl %>?n=<%= entry.name %>" class="feed-entry__feed"
                                ><%= t('html_feed.feed_info') %> /?n=<%= entry.name %></a
                            >
                            <% } %>
                        </div>
                        <time class="feed-entry__time" datetime="<%= timestamp.toISOString() %>"
                            ><%= timestamp.toUTCString() %></time
                        >
                    </header>
                    <h2 class="feed-entry__title"><%= entry.title || t('html_feed.no_title') %></h2>
                    <% if (entry.description) { %>
                    <p class="feed-entry__description"><%= entry.description %></p>
                    <% } %>
                    <div class="feed-entry__link_area">
                        <a class="feed-entry__link" href="<%= entry.url %>" target="_blank" rel="noopener noreferrer" a
                            ><%= entry.url %></a
                        >
                        <button
                            class="button"
                            onClick="deleteEntry(event, '<%= encodeURI(entry.url) %>', '<%= entry.name %>')"
                        >
                            <%= t('html_feed.delete') %>
                        </button>
                    </div>
                </article>
                <% }) %>
            </section>
            <% if (hasPagination) { %>
            <nav class="pagination" aria-label="Pagination">
                 <span class="pagination__summary">
                    <%= t('html_feed.pagination.text', { page: safePage, totalPages, start: Math.min(safeTotal, (safePage - 1) * safeLimit + 1), end: Math.min(safeTotal, safePage * safeLimit), total: safeTotal }) %>
                </span>
                <div class="pagination__actions">
                    <% if (safePage > 1) { %>
                    <a
                        class="button button--ghost"
                        href="<%= rootUrl %><%= url %>&amp;page=<%= safePage - 1 %>&amp;limit=<%= safeLimit %>"
                        ><%= t('html_feed.pagination.previous') %></a
                    >
                    <% } else { %>
                    <span class="button button--ghost button--disabled"><%= t('html_feed.pagination.previous') %></span>
                    <% } %>
                    <% if (safePage < totalPages) { %>
                    <a
                        class="button button--ghost"
                        href="<%= rootUrl %><%= url %>&amp;page=<%= safePage + 1 %>&amp;limit=<%= safeLimit %>"
                        ><%= t('html_feed.pagination.next') %></a
                    >
                    <% } else { %>
                    <span class="button button--ghost button--disabled"><%= t('html_feed.pagination.next') %></span>
                    <% } %>
                </div>
            </nav>
            <% } %>
            <% } %>
        </main>
        <script>
            function deleteEntry(event, url, name) {
                const button = event.currentTarget
                const originalLabel = button.textContent

                if (!confirm(`<%= t('html_feed.delete_action') %> ${decodeURI(url)} from ${name} ?`)) return

                button.disabled = true
                button.textContent = "<%= t('html_feed.deleting') %>"

                fetch(`./del?u=${url}&n=${encodeURIComponent(name)}`)
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error(`Failed with status ${response.status}`)
                        }

                        navigation.reload()
                    })
                    .catch(() => {
                        alert("<%= t('html_feed.delete_failed') %>")
                        button.disabled = false
                        button.textContent = originalLabel
                    })
            }
        </script>
    </body>
</html>
