<!DOCTYPE html>
<html lang="<%= locale %>">
    <head>
        <meta charset="utf-8" />
        <title><%= t('common.site_title') %>:  <%= t('index.subtitle') %></title>
        <meta name="robots" content="<%= public ? 'index,follow' : 'noindex,nofollow' %>" />
        <meta name="keywords" content="rss todolist, todolist" />
        <meta name="author" content="Gr&eacute;gory Paul" />
        <meta name="description" content="<%= t('index.meta.description') %>" />
        <link rel="stylesheet" href="./static/style.css" />
        <link rel="icon" type="image/png" href="./static/favicon.png" />
        <link rel="manifest" href="./static/manifest.webmanifest" />
        <meta name="viewport" content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0" />
    </head>

    <body>
        <main>
            <%- include('partials/header', {
                description: t('index.meta.description')
            }) %>

            <section class="card card--intro">
                <h2><%= t('index.how_it_works.title') %></h2>
                <p>
                    <%= t('index.how_it_works.description') %>
                </p>
                <ul class="feature-list">
                    <li><%= t('index.how_it_works.features.0') %></li>
                    <li><%= t('index.how_it_works.features.1') %></li>
                    <li><%= t('index.how_it_works.features.2') %></li>
                </ul>
            </section>

            <% if (public) { %>
            <section class="card card--notice">
                <h3><%= t('index.public_instance.title') %></h3>
                <p>
                    <%= t('index.public_instance.warnings.0') %>
                    <%= t('index.public_instance.warnings.1') %>
                </p>
                <p>
                    <%= t('index.public_instance.self_host') %> (<a
                        href="https://github.com/paulgreg/rsstodolist-node-server"
                        target="_blank"
                        rel="noopener noreferrer"
                        ><%= t('common.instructions') %></a
                    >).
                </p>
            </section>
            <% } %>
            <datalist id="feed-names">
                <% if (!public ) { %><% feedNames.forEach(feedName => { %>
                <option value="<%= feedName %>"></option>
                <% }) %> <% } %>
            </datalist>

            <div class="card-stack">
                <details id="submitDetails" class="card card--collapsible" open>
                    <summary><%= t('index.add_delete_item.title') %></summary>
                    <form class="stacked-form" method="get" id="submitForm" action="add">
                        <div class="form-row form-row--options">
                            <span class="label"><%= t('index.add_delete_item.form.action') %></span>
                            <label><input type="radio" name="action" value="add" checked /> <%= t('index.add_delete_item.form.add') %></label>
                            <label><input type="radio" name="action" value="del" /> <%= t('index.add_delete_item.form.del') %></label>
                        </div>
                        <div class="form-row">
                            <label class="label" for="name"><%= t('index.add_delete_item.form.name') %></label>
                            <input
                                id="name"
                                type="text"
                                name="name"
                                placeholder="somename"
                                maxlength="<%= lengths.name %>"
                                value="<%= name %>"
                                autocomplete="<%= public ? 'on' : 'off' %>"
                                autocapitalize="off"
                                required
                                list="feed-names"
                            />
                        </div>
                        <div class="form-row">
                            <label class="label" for="url"><%= t('index.add_delete_item.form.url') %></label>
                            <input
                                id="url"
                                type="url"
                                name="url"
                                placeholder="<%= t('index.add_delete_item.form.example_url') %>"
                                value="<%= url %>"
                                required
                                maxlength="<%= lengths.url %>"
                            />
                        </div>
                        <div class="form-row">
                            <label class="label" for="title"><%= t('index.add_delete_item.form.title') %></label>
                            <input
                                id="title"
                                type="text"
                                name="title"
                                placeholder="<%= t('index.add_delete_item.form.example_title') %>"
                                maxlength="<%= lengths.title %>"
                                value="<%= title %>"
                            />
                        </div>
                        <div class="form-row">
                            <label class="label" for="description"><%= t('index.add_delete_item.form.description') %></label>
                            <input
                                id="description"
                                type="text"
                                name="description"
                                placeholder="<%= t('index.add_delete_item.form.example_description') %>"
                                maxlength="<%= lengths.description%>"
                                value="<%= description %>"
                            />
                        </div>
                        <div class="form-row">
                            <input type="submit" class="button" value="<%= t('index.add_delete_item.form.submit') %>" />
                        </div>
                        <% if (public) { %>
                        <p class="inline-warning">
                            <%= t('index.add_delete_item.warning') %>
                        </p>
                        <% } %>
                    </form>
                </details>

                <details id="goDetails" class="card card--collapsible" open>
                    <summary><%= t('index.access_feed.title') %></summary>
                    <form class="stacked-form" method="get" id="goForm" action="./">
                        <div class="form-row">
                            <label class="label" for="name-go"><%= t('index.access_feed.form.name') %></label>
                            <input
                                id="name-go"
                                type="text"
                                name="name"
                                placeholder="<%= t('index.access_feed.form.example_name') %>"
                                maxlength="<%= lengths.name %>"
                                value="<%= name %>"
                                autocomplete="<%= public ? 'on' : 'off' %>"
                                autocapitalize="off"
                                list="feed-names"
                                required
                            />
                        </div>
                        <div class="form-row">
                            <input type="submit" class="button" value="<%= t('index.access_feed.form.view_feed') %>" />
                        </div>
                    </form>
                    <p>
                        <%= t('index.access_feed.direct_url') %>
                        <a href="?name=somename" rel="nofollow"> <strong>/?name</strong>=somename </a>
                    </p>
                    <p>
                        <%= t('index.access_feed.limit_info') %>
                    </p>
                </details>

                <% if (!public) { %>
                <details class="card card--collapsible" open>
                    <summary><%= t('index.list_feeds.title') %></summary>
                    <p>
                        <%= t('index.list_feeds.description') %>
                        <a href="<%= rootUrl %>/list" rel="nofollow">
                            <strong><%= t('index.list_feeds.link') %></strong>
                        </a>
                    </p>
                </details>
                <details class="card card--collapsible" open>
                    <summary><%= t('index.search_feeds.title') %></summary>
                    <form class="stacked-form" method="get" action="<%= rootUrl %>/search">
                        <div class="form-row">
                            <label class="label" for="q"><%= t('index.search_feeds.form.keyword') %></label>
                            <input type="text" id="q" name="q" placeholder="<%= t('index.search_feeds.form.example_keyword') %>" minlength="2" required />
                        </div>
                        <div class="form-row">
                            <input type="submit" class="button" value="<%= t('index.search_feeds.form.submit') %>" />
                        </div>
                    </form>
                </details>
                <% } %>

                <details class="card card--collapsible">
                    <summary><%= t('index.browser_extensions.title') %></summary>
                    <p>
                        <%= t('index.browser_extensions.description') %>
                        <a href="https://addons.mozilla.org/fr/firefox/addon/rsstodolist/">Firefox addon</a> <%= t('common.and') %>
                        <a href="https://chrome.google.com/webstore/detail/rsstodolist/gjnfedompndjcoeannmcppbckbkjhpkd"
                            >Chrome extension</a
                        >.
                    </p>
                </details>

                <details class="card card--collapsible">
                    <summary><%= t('index.add_by_url.title') %></summary>
                    <p>
                        <a href="add?name=somename&amp;url=https://fr.wikipedia.org/" rel="nofollow">
                            <strong>/add?name</strong>=somename<strong>&amp;url</strong>=https://fr.wikipedia.org/ </a
                        ><br />
                        <a href="del?name=somename&amp;url=https://fr.wikipedia.org/" rel="nofollow">
                            <strong>/del?name</strong>=somename<strong>&amp;url</strong>=https://fr.wikipedia.org/
                        </a>
                    </p>
                    <p>
                        <%= t('index.add_by_url.notes.0') %>
                        <%= t('index.add_by_url.notes.1') %>
                    </p>
                    <p>
                        <%= t('index.add_by_url.notes.2') %>
                        <%= t('index.add_by_url.notes.3') %>
                    </p>
                </details>

                <details class="card card--collapsible">
                    <summary><%= t('index.bookmarklet.title') %></summary>
                    <p>
                        <%= t('index.bookmarklet.description') %>
                        <a
                            href="http://en.wikipedia.org/wiki/Bookmarklet"
                            title="<%= t('index.bookmarklet.link_text') %>"
                            >bookmarklet</a
                        >. <%= t('index.bookmarklet.instructions') %>
                        <code class="block"
                            >javascript:{const n=prompt('feed name ?'); if (n) window.open(`<%= rootUrl
                            %>/add?n=${n}&amp;url=${encodeURIComponent(window.location)}`)}</code
                        >
                    </p>
                </details>

                <details id="related" class="card card--collapsible">
                    <summary><%= t('index.related_projects.title') %></summary>
                    <ul>
                        <li>
                            <a href="https://github.com/paulgreg/rsstodolist-node-server">rsstodolist-node-server</a> —
                            <%= t('index.related_projects.projects.0') %>
                        </li>
                        <li>
                            <a href="https://github.com/paulgreg/rsstodolist-addon">rsstodolist-addon</a> —
                            <%= t('index.related_projects.projects.1') %>
                        </li>
                        <li>
                            <a href="https://github.com/paulgreg/rsstodolist-react-native">rsstodolist-react-native</a>
                            — <%= t('index.related_projects.projects.2') %>
                        </li>
                        <li>
                            <a href="https://github.com/paulgreg/rsstodolist-django-server"
                                >rsstodolist-django-server</a
                            >
                            — <%= t('index.related_projects.projects.3') %>
                        </li>
                    </ul>
                </details>

                <details class="card card--collapsible">
                    <summary><%= t('common.contact') %></summary>
                    <p><%= t('common.contact') %> <a href="https://paulgreg.me/">paulgreg.me</a>.</p>
                </details>
            </div>
        </main>
        <script>
            const submitForm = document.querySelector('#submitForm')
            const radios = submitForm.querySelectorAll('input[name="action"]')

            // Update form action on radio click
            radios.forEach((radio) =>
                radio.addEventListener('click', (e) => {
                    submitForm.setAttribute('action', e.target.value)
                })
            )
        </script>
    </body>
</html>
